# ── NexusAI environment configuration ──────────────────────────────────────
# Copy this file to .env and fill in the values before starting the stack.

# ── Dashboard ───────────────────────────────────────────────────────────────
# Flask secret key — CHANGE THIS in production (use a long random string)
NEXUSAI_SECRET_KEY=change-me-in-production
# Deployment environment. Set this to production or prod to reject placeholder
# vault-encryption keys at startup.
NEXUSAI_ENV=development
# Optional dedicated Fernet seed for the encrypted API-key vault. Set a long,
# random value in production instead of reusing the dashboard session secret.
NEXUS_MASTER_KEY=

# Port the dashboard web UI listens on
DASHBOARD_PORT=5000

# ── Database ────────────────────────────────────────────────────────────────
# SQLAlchemy connection URL (default: SQLite in ./data/)
# For PostgreSQL: postgresql://user:password@host:5432/nexusai
DATABASE_URL=sqlite:///data/nexusai.db

# ── Control Plane ───────────────────────────────────────────────────────────
# Port the control plane API listens on
CONTROL_PLANE_PORT=8000
# Dashboard URL to reach the control-plane API.
# For split blue/green dashboard topology, set this to a reachable host/IP.
CONTROL_PLANE_URL=http://control_plane:8000
# Optional API token for control-plane auth (leave empty to disable auth enforcement)
CONTROL_PLANE_API_TOKEN=
# Optional token for control-plane requests to isolated worker inference APIs.
# Nodes opt in by setting request_token_env in their private worker config.
NEXUS_WORKER_REQUEST_TOKEN=
# Dashboard control-plane request timeout in seconds.
CP_TIMEOUT=5
# Cloud context egress policy for scheduler cloud backends: allow|redact|block
NEXUSAI_CLOUD_CONTEXT_POLICY=allow
# Worker routing/latency scoring tuning
NEXUSAI_WORKER_LATENCY_EMA_ALPHA=0.30
NEXUSAI_WORKER_DEFAULT_LATENCY_MS=800
# GitHub webhook replay/timestamp protections
NEXUSAI_GITHUB_WEBHOOK_REQUIRE_DELIVERY_ID=1
NEXUSAI_GITHUB_WEBHOOK_MAX_SKEW_SECONDS=300
NEXUSAI_GITHUB_WEBHOOK_REQUIRE_DATE_HEADER=0
NEXUSAI_GITHUB_WEBHOOK_DEDUP_TTL_SECONDS=86400
# Optional per-endpoint hardening overrides (examples):
# CP_MAX_BODY_BYTES_CHAT_MESSAGES=200000
# CP_RATE_LIMIT_CHAT_MESSAGES_COUNT=120
# CP_RATE_LIMIT_CHAT_MESSAGES_WINDOW_SECONDS=60
# Repo workspace runtime toolchains baked into the control_plane image at build time.
# Use `all` or a comma-separated list such as: node,dotnet,go,rust,cpp
NEXUSAI_REPO_RUNTIME_TOOLCHAINS=node,dotnet,go,rust,cpp
# Default .NET SDK channel to install when `dotnet` is included above.
NEXUSAI_REPO_RUNTIME_DOTNET_CHANNEL=8.0
# Bounded resource envelope for the control plane. Tune only after measuring
# a representative workload; these values prevent a single core service from
# consuming the whole host.
NEXUSAI_CONTROL_PLANE_SHM_SIZE=1g
NEXUSAI_CONTROL_PLANE_CPUS=2.0
NEXUSAI_CONTROL_PLANE_MEM_LIMIT=4g
NEXUSAI_CONTROL_PLANE_MEMSWAP_LIMIT=6g
NEXUSAI_CONTROL_PLANE_PIDS_LIMIT=768

# ── Dashboard and Telemetry Resource Limits ─────────────────────────────────
# Blue/green dashboard instances share the dashboard limits below.
NEXUSAI_DASHBOARD_SHM_SIZE=256m
NEXUSAI_DASHBOARD_CPUS=1.0
NEXUSAI_DASHBOARD_MEM_LIMIT=1g
NEXUSAI_DASHBOARD_MEMSWAP_LIMIT=2g
NEXUSAI_DASHBOARD_PIDS_LIMIT=256
NEXUSAI_GATEWAY_SHM_SIZE=64m
NEXUSAI_GATEWAY_CPUS=0.5
NEXUSAI_GATEWAY_MEM_LIMIT=256m
NEXUSAI_GATEWAY_MEMSWAP_LIMIT=512m
NEXUSAI_GATEWAY_PIDS_LIMIT=128
NEXUSAI_PROMETHEUS_SHM_SIZE=128m
NEXUSAI_PROMETHEUS_CPUS=0.75
NEXUSAI_PROMETHEUS_MEM_LIMIT=1g
NEXUSAI_PROMETHEUS_MEMSWAP_LIMIT=2g
NEXUSAI_PROMETHEUS_PIDS_LIMIT=256

# ── Worker Agent ────────────────────────────────────────────────────────────
# Port the worker agent listens on
WORKER_AGENT_PORT=8001
# Docker worker-agent URL for the control plane. Keep the Docker-network default
# unless the worker agent runs outside the compose stack.
WORKER_CONTROL_PLANE_URL=http://control_plane:8000
# Conservative resource envelope for the bundled Docker worker agent. Override
# these only after measuring the worker's actual workload.
NEXUSAI_CORE_WORKER_SHM_SIZE=512m
NEXUSAI_CORE_WORKER_CPUS=1.0
NEXUSAI_CORE_WORKER_MEM_LIMIT=1g
NEXUSAI_CORE_WORKER_MEMSWAP_LIMIT=2g
NEXUSAI_CORE_WORKER_PIDS_LIMIT=256
# Standalone nexus_worker config path
NEXUS_WORKER_CONFIG_PATH=worker_node/nexus_worker/config.yaml.example
# Cloud context egress policy for standalone nexus_worker: allow|redact|block
NEXUS_WORKER_CLOUD_CONTEXT_POLICY=redact
# Optional local vLLM model names (comma-separated) for discovery
VLLM_MODELS=

# ── LLM Backends ────────────────────────────────────────────────────────────
# Cloud keys are preferred in Dashboard Settings -> API Keys (encrypted DB storage).
# Environment variables below are optional fallback only.

# OpenAI (fallback)
OPENAI_API_KEY=

# Ollama Cloud (fallback for control-plane cloud backends and worker-node fleets)
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/api

# Anthropic Claude (fallback)
ANTHROPIC_API_KEY=

# Google Gemini (fallback)
GEMINI_API_KEY=

# ── Platform AI Privileged Controls ─────────────────────────────────────────
# Platform AI config changes and autonomous pipeline relaunches stay in
# proposal/review mode unless these independent flags are explicitly enabled.
NEXUS_PLATFORM_AI_CONFIGURATION_MUTATIONS_ENABLED=0
NEXUS_PLATFORM_AI_AUTONOMOUS_PIPELINES_ENABLED=0
# Enable privileged Platform AI actions (deploy, repo edit) and restrict by operator allowlist.
NEXUS_PLATFORM_AI_PRIVILEGED_ENABLED=0
NEXUS_PLATFORM_AI_OWNER_ALLOWLIST=
# Feature flags for privileged actions.
NEXUS_PLATFORM_AI_REPO_EDIT_ENABLED=0
NEXUS_PLATFORM_AI_EXTERNAL_REPO_EDIT_ENABLED=0
NEXUS_PLATFORM_AI_DEPLOY_ENABLED=0
# Public (non-privileged) project-edit path.
NEXUS_PLATFORM_AI_PROJECT_EDIT_ENABLED=0
# Runner commands (required when matching feature flags are enabled).
NEXUS_PLATFORM_AI_REPO_EDIT_RUN_CMD=
NEXUS_PLATFORM_AI_EXTERNAL_REPO_EDIT_RUN_CMD=
# Optional working directories.
NEXUS_PLATFORM_AI_REPO_EDIT_CWD=
NEXUS_PLATFORM_AI_REPO_EDIT_TIMEOUT_SECONDS=1800
NEXUS_PLATFORM_AI_REPO_EDIT_AUTO_DEPLOY=0
NEXUS_PLATFORM_AI_PROJECT_EDIT_RUN_CMD=
NEXUS_PLATFORM_AI_PROJECT_EDIT_CWD=
NEXUS_PLATFORM_AI_PROJECT_EDIT_TIMEOUT_SECONDS=1800
# Platform AI attachment boundaries. Files are streamed and rejected before a
# per-file or per-session hard limit is exceeded.
NEXUS_PLATFORM_AI_UPLOAD_MAX_FILES=100
NEXUS_PLATFORM_AI_UPLOAD_MAX_FILE_BYTES=134217728
NEXUS_PLATFORM_AI_UPLOAD_MAX_TOTAL_BYTES=1073741824
# Soft attachment guardrails (warnings before the hard limits).
NEXUS_PLATFORM_AI_UPLOAD_SOFT_MAX_FILES=250
NEXUS_PLATFORM_AI_UPLOAD_SOFT_MAX_BYTES=5368709120

# ── Blue/Green Deploy Controls (Dashboard Settings -> Deploy tab) ─────────
# Disabled by default; enable only after validating blue/green runtime.
NEXUSAI_DEPLOY_ENABLE=0
NEXUSAI_DEPLOY_STRATEGY=bluegreen
NEXUSAI_STOP_PREVIOUS_COLOR=0
# DB drift guard auto-sync policy for legacy volume reconciliation:
# 1 = auto-sync (host DB canonical, minimal operator intervention)
# 0 = strict fail-closed (manual reconciliation required)
NEXUSAI_DB_DRIFT_AUTO_SYNC=1
# Example:
# NEXUSAI_DEPLOY_RUN_CMD=docker run --rm -e NEXUSAI_DEPLOY_STRATEGY=bluegreen -e NEXUSAI_BLUEGREEN_SWITCH_CMD=./scripts/switch-dashboard-color.sh -e NEXUSAI_COMPOSE_PROJECT_NAME=nexusai -e NEXUSAI_LEGACY_DATA_VOLUME=nexusai_nexus-data -e NEXUSAI_DB_DRIFT_AUTO_SYNC=1 -v /var/run/docker.sock:/var/run/docker.sock -v /opt/NexusAI:/opt/NexusAI -w /opt/NexusAI docker:27-cli sh -lc "sh ./scripts/deploy-bluegreen.sh"
NEXUSAI_DEPLOY_RUN_CMD=
# Switch command used by deploy-bluegreen.sh
NEXUSAI_BLUEGREEN_SWITCH_CMD=./scripts/switch-dashboard-color.sh
